      "public_prompt_metadata": {
        "PARAM_DESCRIPTION": {
          "value": "- gamma: adiabatic index of the gas. It should be a positive real number.\n- T: temperature of the medium in Kelvin. It should be a positive real number.\n- M: molar mass of the medium. It should be a positive real number.",
          "line": 10
